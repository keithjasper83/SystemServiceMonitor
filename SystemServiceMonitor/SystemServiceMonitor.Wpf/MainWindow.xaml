<Window x:Class="SystemServiceMonitor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="SystemServiceMonitor Dashboard" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- NOTE: LEAVE THIS ICON SOURCE ALONE. The IconSource has broken the application previously. -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="SystemServiceMonitor"
                        IconSource="pack://application:,,,/icon.ico"
                        TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open Dashboard" Click="MenuItem_OpenDashboard_Click" />
                    <Separator />
                    <MenuItem Header="Exit" Click="MenuItem_Exit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <!-- Left Panel (Add/Edit Resource) -->
            <Expander x:Name="ExpanderAddResource" Grid.Row="1" Grid.Column="0" Header="Resource Configuration" ExpandDirection="Right" IsExpanded="False" Margin="10">
                <Grid Width="300" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FormPanel">
                            <TextBlock Text="Display Name" />
                            <TextBox x:Name="TxtDisplayName" Margin="0,0,0,10" />

                            <TextBlock Text="Type" />
                            <ComboBox x:Name="CboType" Margin="0,0,0,10" SelectionChanged="CboType_SelectionChanged" />

                            <TextBlock Text="Start Command" />
                            <TextBox x:Name="TxtStartCommand" Margin="0,0,0,10" />

                            <TextBlock Text="Stop Command" />
                            <TextBox x:Name="TxtStopCommand" Margin="0,0,0,10" />

                            <TextBlock Text="Restart Command" />
                            <TextBox x:Name="TxtRestartCommand" Margin="0,0,0,10" />

                            <TextBlock Text="Healthcheck URL/Command" />
                            <TextBox x:Name="TxtHealthcheck" Margin="0,0,0,10" />

                            <TextBlock Text="Working Directory" />
                            <TextBox x:Name="TxtWorkingDir" Margin="0,0,0,10" />

                            <TextBlock Text="WSL Distro (If applicable)" />
                            <TextBox x:Name="TxtWslDistro" Margin="0,0,0,10" />

                            <TextBlock Text="Docker Identifier (If applicable)" />
                            <TextBox x:Name="TxtDockerId" Margin="0,0,0,10" />

                            <TextBlock Text="Dependency IDs (Comma separated)" />
                            <TextBox x:Name="TxtDependencies" Margin="0,0,0,10" />

                            <TextBlock Text="GitHub Repo URL (Optional)" />
                            <TextBox x:Name="TxtGitHubRepo" Margin="0,0,0,10" />

                            <CheckBox x:Name="ChkAutoRepair" Content="Auto Repair Enabled" Margin="0,0,0,10" IsChecked="True" />
                            <CheckBox x:Name="ChkRequiresElevation" Content="Requires Elevation" Margin="0,0,0,10" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Cancel" Width="75" Margin="0,0,10,0" Click="BtnFormCancel_Click" />
                        <Button Content="Save" Width="75" Click="BtnFormSave_Click" />
                    </StackPanel>
                </Grid>
            </Expander>



            <Grid Grid.Row="1" Grid.Column="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Discovery Section -->
                <TextBlock Text="Resource Discovery" FontWeight="Bold" FontSize="16" Margin="10,0,0,10" Grid.Row="0" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,10">
                    <Label Content="Resource Type:" VerticalAlignment="Center" />
                    <ComboBox x:Name="CmbResourceType" Width="150" Margin="10,0" SelectionChanged="CmbResourceType_SelectionChanged" />
                    <Label Content="Filter/Path:" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtResourceFilter" Width="200" Margin="10,0" VerticalContentAlignment="Center" KeyDown="TxtResourceFilter_KeyDown" />
                    <Button x:Name="BtnDiscover" Content="_Discover" Width="100" Margin="10,0" Click="BtnDiscover_Click" IsDefault="True"/>
                </StackPanel>
                <DataGrid x:Name="DiscoveryGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" Margin="10" Height="150">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="10" HorizontalAlignment="Right">
                    <Button Content="Add Selected to Dashboard" Click="BtnAddDiscovered_Click" Width="180" />
                </StackPanel>

                <!-- Dashboard Section -->
                <TextBlock Text="Dashboard" FontWeight="Bold" FontSize="16" Margin="10,10,0,10" Grid.Row="4" />
                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="10,0,10,10">
                    <Button Content="_Add Resource" Width="100" Margin="0,0,10,0" Click="BtnAddResource_Click" />
                    <Button Content="_Edit Selected" Width="100" Margin="0,0,10,0" Click="BtnEditResource_Click" />
                    <Button Content="_Delete Selected" Width="100" Margin="0,0,10,0" Click="BtnDeleteResource_Click" />
                    <Button Content="AI D_iagnosis" Width="100" Margin="0,0,10,0" Click="BtnAiDiagnosis_Click" ToolTip="Diagnose selected failing resource" />
                    <Button Content="E_xecute Repair" Width="100" Margin="0,0,10,0" Click="BtnExecuteRepair_Click" ToolTip="Execute AI Recommended Action" IsEnabled="False" x:Name="BtnExecuteRepair" />
                </StackPanel>

                <DataGrid x:Name="ResourceGrid" Grid.Row="6" AutoGenerateColumns="False" IsReadOnly="True" Margin="10" SelectionChanged="ResourceGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="150" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100" />
                        <DataGridTextColumn Header="Health" Binding="{Binding HealthState}" Width="80" />
                        <DataGridTextColumn Header="State" Binding="{Binding ObservedState}" Width="80" />
                        <DataGridTextColumn Header="Repair State" Binding="{Binding RepairState}" Width="100" />
                        <DataGridTextColumn Header="Dependencies" Binding="{Binding DependencyIds}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="10" HorizontalAlignment="Right">
                    <Button Content="Refresh" Click="BtnRefresh_Click" Width="80" Margin="0,0,10,0" />
                </StackPanel>
            </Grid>


            <!-- Bottom Panel (Logs) -->
            <Expander x:Name="ExpanderLogs" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Header="Logs" ExpandDirection="Up" IsExpanded="False" Margin="10">
                <Grid Height="150">
                    <RichTextBox x:Name="LogRichTextBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="10" FontFamily="Consolas">
                        <FlowDocument>
                            <Paragraph x:Name="LogParagraph" />
                        </FlowDocument>
                    </RichTextBox>
                </Grid>
            </Expander>


            <!-- Right Panel (AI Diagnosis) -->
            <Expander x:Name="ExpanderAiDiagnosis" Grid.Row="1" Grid.Column="2" Header="AI Diagnosis Output" ExpandDirection="Left" IsExpanded="False" Margin="10">
                <Grid Width="300">
                    <TextBox x:Name="AiLogTextBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="10" FontFamily="Consolas" TextWrapping="Wrap" />
                </Grid>
            </Expander>

</Grid>
    </Grid>
</Window>
